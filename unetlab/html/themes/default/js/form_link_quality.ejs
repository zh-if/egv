<form id="edit-link-quality-form" class="container col-md-12 col-lg-12 edit-link-quality-form" data-path="<%=id%>">
    <div class="row col-md-9 top-part">
        <label class="edit-link-quality-label">Link Quality: <%=source_node_name%> ( <%=source_label%> ) <-> <%=destination_node_name%> ( <%=destination_label%> ) </label><br>
        <div class="form-group">
            <label class="control-label form-group-addon">Source :</label>
	    <input class="form-control" type="text" value="<%=source_node_name%>" disabled>
            </div>
        <div class="form-group">
            <label class="control-label form-group-addon">Delay (ms)</label>
            <input type="number" name="link[source_delay]" min="0" max="10000" class="form-control link-sourc-delay" data-path="<%=id%>" value="<%=source_delay%>">
            </div>
        <div class="form-group">
            <label class="control-label form-group-addon">Loss (%)</label>
            <input type="number" name="link[source_loss]" min="0" max="100" class="form-control link-source-loss" data-path="<%=id%>" value="<%=source_loss%>">
            </div>
        <div class="form-group">
            <label class="control-label form-group-addon">Rate(kbps)</label>
            <input type="number" name="link[source_bandwidth]" min="1" max="10000000" class="form-control link-source-bandwidth" data-path="<%=id%>" value="<%=source_bandwidth%>">
            </div>
	<div class="col-md-1"></div>
        <div class="form-group">
            <label class="control-label form-group-addon">Destination :</label>
            <input class="form-control" type="text" value="<%=destination_node_name%>" disabled>
            </div>
        <div class="form-group">
            <label class="control-label form-group-addon">Delay (ms)</label>
            <input type="number" name="link[destination_delay]" min="0" max="10000" class="form-control link-destination-delay" data-path="<%=id%>" value="<%=destination_delay%>">
            </div>
        <div class="form-group">
            <label class="control-label form-group-addon">Loss (%)</label>
            <input type="number" name="link[destination_loss]" min="0" max="100" class="form-control link-destination-loss" data-path="<%=id%>" value="<%=destination_loss%>">
            </div>
        <div class="form-group">
            <label class="control-label form-group-addon">Rate(kbps)</label>
            <input type="number" name="link[destination_bandwidth]" min="1" max="10000000" class="form-control link-destination-bandwidth" data-path="<%=id%>" value="<%=destination_bandwidth%>">
            </div>
        </div>
    <div class="row col-md-3 btn-part">
        <button type="submit" class="btn btn-success edit-link-quality-form-save" data-path="<%=id%>"><%=MESSAGES[228]%></button>
        <button type="button" class="btn cancelForm" data-path="<%=id%>"><%=MESSAGES[16]%></button>
    </div>
    <input type="hidden" class="firstLinkValues-source-delay" value="<%=source_delay%>">
    <input type="hidden" class="firstLinkValues-source-loss" value="<%=source_loss%>">
    <input type="hidden" class="firstLinkValues-source-bandwidth" value="<%=source_bandwidth%>">
    <input type="hidden" class="firstLinkValues-destination-delay" value="<%=destination_delay%>">
    <input type="hidden" class="firstLinkValues-destination-loss" value="<%=destination_loss%>">
    <input type="hidden" class="firstLinkValues-destination-bandwidth" value="<%=destination_bandwidth%>">
    <input type="hidden" name="link[id]" value="<%=id%>">
    <input type="hidden" name="link[sourceNode]" value="<%=SourceId%>">
    <input type="hidden" name="link[destnode]" value="<%=DestId%>">
    <input type="hidden" name="link[sourceinterface]" value="<%=SourceIfaceId%>">
    <input type="hidden" name="link[destinterface]" value="<%=DestIfaceId%>">
</form>

<div class="config-sets row">
	<div class="col-md-3 col-lg-2 col-sm-3">
		&nbsp;&nbsp;
	</div>
	<div class="col-md-1 col-lg-1 col-sm-1">
		<label>Config Set</label>
	</div>
	<div class="col-md-3 col-lg-3 col-sm-3" >
		<form id="config-sets">
			<select id="configsetselect">
				<option style="width=90px;" value="default">Default</option>
				<% $.each(configsets, function (key, configset) { %>
					<option style="width=90px;" value="<%=key%>"><%=configset['name']%></option>
				<% }); %>
			</select>
		</form>
	</div>
	<div class="col-md-3 col-lg-3 col-sm-3" >
                <button type="button" class="btn action-new-configset" title="<%=MESSAGES[212]%>" style="background:#00a65a;color:#ffffff;font-size:10px;"><i class="fas fa-plus"></i></button>
                <button type="button" class="btn action-edit-configset" title="<%=MESSAGES[214]%>" style="background:#00a65a;color:#ffffff;font-size:10px;"><i class="fas fa-edit"></i></button>
                <button type="button" class="btn action-delete-configset" title="<%=MESSAGES[213]%>" style="background:#ff4d4d;color:#ffffff;font-size:10px;"><i class="fas fa-times"></i></button>
                <button type="button" class="btn action-upload-configset" title="<%=MESSAGES[202]%>" style="font-size:10px;"><i class="fas fa-upload"></i></button>
                <button type="button" class="btn action-download-configset" title="<%=MESSAGES[203]%>" style="font-size:10px;"><i class="fas fa-download"></i></button>
	</div>
	<div class="col-md-3 col-lg-3 col-sm-3" >
	<button type="button" class="btn action-applyconfigset" title="<%=MESSAGES[215]%>" style="background:#00a65a;color:#ffffff;font-size:10px;"><i class="fas fa-bolt"></i></button>
	<button type="button" class="btn action-noconfigset" title="<%=MESSAGES[216]%>" style="background:#ff4d4d;color:#ffffff;font-size:10px;"><i class="fas fa-bolt"></i></button>
	</div>
</div>
<hr/>
<div class="row row-config-list">
    <div class="config-list col-md-3 col-lg-2 col-sm-3" style="overflow-x: hidden !important;padding-right: 0; margin-right: 0">
        <ul style="margin-right: 0;">
            <% $.each(configs, function (key, config) { %>
            <li>
                <a class="action-configget"
                data-path="<%=key%>"
                href="javascript:void(0)"
                title="<%=(config['config'] == 0 ? MESSAGES[122] : MESSAGES[121]) %>">
                <img src="/images/icons/<%=config['icon']%>"
                width="15" height="15" style="margin-bottom: 1px"
                <%=(config['len'] == 0 ? 'class="grayscale"' : '')%>>
                &nbsp;&nbsp;&nbsp;
                <%=config['name']%>
                </a>
                <span class="absolute-right">
                    <span class="align-flash">
                        <%= config['config'] > 0 ? '<i class="glyphicon glyphicon-flash tg-flash"></i>' : '&nbsp;&nbsp;&nbsp;'%>
                    </span>
                    <label class="checkbox-switch"
                           data-toggle="tooltip"
                           data-placement="bottom"
                           title="<%=config['config'] == 0 ? 'Enable' : 'Disable'%> boot from exported">
                        <input type="checkbox"
                        class="change_config_status"
                        data-path="<%=key%>"
                        data-name="<%=config['name']%>"
                        <%=config['config'] > 0 ? 'checked' : ''%>
			<%=config['config'] > 0 ? 'value="1"' : 'value="0"'%>
                        <%=config['len'] == 0 ? 'disabled' : ''%>>
                        <div class="checkbox-slider-<%=config['config'] > 0 ? 'on' : 'off'%>"></div>
                    </label>
                </span>
                <div class="clearfix"></div><hr style="margin-bottom: 0;margin-top:3px"></li>
            <% }); %>
        </ul>
    </div>
    <div id="config-data" class="col-md-9 col-lg-10 col-sm-9">
    </div>
</div>
